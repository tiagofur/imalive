# Entorno local del backend: copiar a .env (gitignoreado) y ajustar.
# Nunca commitear credenciales reales (docs/procesos/flujo-desarrollo.md §Secretos):
# estas son credenciales locales de docker-compose.yml, no secretos.
APP_ENV=local
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://imalive:imalive@localhost:5436/imalive?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# OTP (issue #39): noop entrega nada (tests), sandbox escribe en un outbox
# fuera del repo, twilio usa la Verify API (credenciales vía TWILIO_* cuando
# el issue #6 entregue la cuenta). OTP_SECRET hashea los códigos en Redis.
OTP_SENDER=sandbox
OTP_SECRET=dev-only-secret-cambiar-en-prod
