# Entorno local del backend: copiar a .env (gitignoreado) y ajustar.
# Nunca commitear credenciales reales (docs/procesos/flujo-desarrollo.md §Secretos):
# estas son credenciales locales de docker-compose.yml, no secretos.
APP_ENV=local
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://imalive:imalive@localhost:5432/imalive?sslmode=disable
REDIS_URL=redis://localhost:6379/0
